# --- GCP (Vertex AI auth is ADC: `gcloud auth application-default login`) ---
GCP_PROJECT=your-project-id
GCS_BUCKET=your-project-id-finops-docs
BILLING_EXPORT_TABLE=your-project-id.billing.gcp_billing_export_v1

# --- Database (local dev; Cloud Run uses DB_UNIX_SOCKET) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finops_rag
DB_USER=raguser
DB_PASSWORD=localdev

# --- Agent ---
RAG_API_URL=http://localhost:8080
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
CONFIDENCE_THRESHOLD=0.7
MAX_RETRIES=2
DASHBOARD_URL=

# --- Frontend ---
# Server-side only (Next.js proxy target); never NEXT_PUBLIC_
API_URL=http://localhost:8080
# Optional app-level key (mandatory on GKE, unused on Cloud Run where IAM protects the API)
API_AUTH_KEY=
